{
  "expo": {
    "name": "Survey Radar",
    "slug": "mobile",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icon.png"
    },
    "android": {
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.mobile"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/audio/chinese_bell_song.wav",
            "./assets/audio/fahhhhhhhhhhhhhh.wav",
            "./assets/audio/generic_ka_ching.wav",
            "./assets/audio/iphone_notification.wav",
            "./assets/audio/kar98k.wav",
            "./assets/audio/meccha_chameleon_whistle.wav",
            "./assets/audio/samsung_notification_sound_earrape.wav",
            "./assets/audio/snapchat_message.wav",
            "./assets/audio/superchat.wav"
          ]
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "c83fbbb3-1228-4ff8-b645-6df1a94ddfb0"
      }
    }
  }
}
